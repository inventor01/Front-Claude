# Copy this file to ~/.front-browser-bridge/content.env
# Do not commit your real key.

# Option A — OpenAI multimodal analysis
FRONT_CONTENT_PROVIDER=openai
FRONT_CONTENT_API_KEY=
FRONT_CONTENT_MODEL=gpt-5.6-luna

# Option B — local Ollama vision model (zero per-call API cost)
# Verified Front default for an 8 GB Apple Silicon Mac: qwen3-vl:4b-instruct.
# Keep the model warm for best latency; use a larger model only on stronger hardware.
# FRONT_CONTENT_PROVIDER=ollama
# FRONT_OLLAMA_MODEL=qwen3-vl:4b-instruct
# FRONT_OLLAMA_ENDPOINT=http://127.0.0.1:11434/api/chat

# Performance controls. These cap EXPENSIVE visual analysis, not X/TikTok discovery.
# Front may collect many more posts than it sends to the vision model.
FRONT_CONTENT_DEEP_VIDEOS=4
FRONT_CONTENT_SCOUT_VIDEOS=2
FRONT_CONTENT_BACKGROUND_VIDEOS=1
